# pnpm 12 reads only registry and auth keys from .npmrc; its settings live in
# pnpm-workspace.yaml (nodeLinker, linkWorkspacePackages, ...).
#
# Read by bun, not pnpm: bun 1.3 takes node-linker from this file, and the bun benches
# (optimal-gate, dev-loop, sliced-gate) run `bun install` at the repository root. The
# value is bun's default for a new workspace; the line keeps bun's linker explicit.
node-linker=isolated
