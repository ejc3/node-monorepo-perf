+    /// A pop does not wait on a heap shard whose lock is taken while another shard has items.
+    #[test]
+    fn test_pop_passes_over_a_busy_heap_shard() {
+        let q: Queue<u32, u32> = Queue::with_heap_shards(0, 2);
+        // One item in each shard.
+        let mut keys = [None, None];
+        for key in 0..64u32 {
+            let shard = q.heap_shard_of(&key);
+            if keys[shard].is_none() {
+                keys[shard] = Some(key);
+                let _ = q.push(5, key);
+            }
+        }
+        let held = q.heaps[0].lock();
+        // Whichever shard a pop starts from, it picks the free one.
+        let mask = q.heaps_non_empty.load(Ordering::Relaxed);
+        assert_eq!(mask, 0b11);
+        for cursor in 0..64 {
+            assert_eq!(q.pick_heap_shard(mask, cursor), 1, "cursor {cursor}");
+        }
+        let (sender, receiver) = std::sync::mpsc::channel();
+        std::thread::scope(|scope| {
+            scope.spawn(|| sender.send(q.pop()).unwrap());
+            let popped = receiver.recv_timeout(Duration::from_secs(10));
+            // Let a pop that is waiting on the busy shard finish before asserting.
+            drop(held);
+            assert_eq!(
+                popped.expect("pop waited on the busy shard"),
+                Some((5, keys[1].unwrap()))
+            );
+        });
+    }
