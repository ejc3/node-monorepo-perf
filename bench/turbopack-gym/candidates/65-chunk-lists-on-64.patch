+/// A chunk group's client chunks as a client reference manifest entry lists them: for each
+/// JavaScript chunk, its URL (the path from the client root, URI-encoded, between the asset
+/// prefix and suffix) and, for a merged chunk, its component chunks' paths and sizes; and the
+/// JavaScript chunks' unencoded paths. The client references of a layout segment all use the
+/// segment's chunk group, and pages under the same layouts share those groups, so this is a
+/// task: each list is computed once instead of once per client reference and page.
+#[turbo_tasks::value(shared)]
+struct ClientChunkList {
+    /// (URL, the component chunks' paths and sizes; empty when the chunk is not merged)
+    chunks: Vec<(RcStr, Vec<(RcStr, u64)>)>,
+    js_paths: Vec<RcStr>,
+}
+
+#[turbo_tasks::function]
+async fn client_chunk_list(
+    chunk_group: ResolvedVc<ChunkGroupResult>,
+    client_relative_path: FileSystemPath,
+    prefix_path: RcStr,
+    suffix_path: RcStr,
+) -> Result<Vc<ClientChunkList>> {
+    let chunks = chunk_group.primary_assets().await?;
+    let paths = chunks
+        .iter()
+        .map(async |chunk| Ok((*chunk, chunk.path().owned().await?)))
+        .try_join()
+        .await?;
+    let js_chunks = paths
+        .into_iter()
+        .filter_map(|(chunk, chunk_path)| {
+            client_relative_path
+                .get_path_to(&chunk_path)
+                .map(|path| (chunk, path.to_string()))
+        })
+        // It's possible that a chunk also emits CSS files, that will be handled separately.
+        .filter(|(_, path)| path.ends_with(".js"))
+        .collect::<Vec<_>>();
+    let entries = js_chunks
+        .iter()
+        .map(async |(chunk, path)| {
+            let url = RcStr::from(format!(
+                "{}{}{}",
+                prefix_path,
+                path.split('/').map(encode_uri_component).format("/"),
+                suffix_path
+            ));
+            let components = client_chunk_components(**chunk, client_relative_path.clone())
+                .owned()
+                .await?;
+            Ok((url, components))
+        })
+        .try_join()
+        .await?;
+    Ok(ClientChunkList {
+        chunks: entries,
+        js_paths: js_chunks
+            .into_iter()
+            .map(|(_, path)| RcStr::from(path))
+            .collect(),
+    }
+    .cell())
+}
+
+/// The SSR chunk paths (from the node root) of a layout segment's SSR chunks, as a client
+/// reference's SSR manifest entry lists them. A task for the same reason as
+/// [`client_chunk_list`].
+#[turbo_tasks::value(transparent)]
+struct SsrChunkPaths(Vec<RcStr>);
+
+#[turbo_tasks::function]
+async fn ssr_chunk_paths(
+    assets: ResolvedVc<OutputAssetsWithReferenced>,
+    node_root: FileSystemPath,
+) -> Result<Vc<SsrChunkPaths>> {
+    let chunks = assets.primary_assets().await?;
+    let paths = chunks
+        .iter()
+        .map(async |chunk| chunk.path().owned().await)
+        .try_join()
+        .await?;
+    Ok(Vc::cell(
+        paths
+            .iter()
+            .filter_map(|chunk_path| node_root.get_path_to(chunk_path).map(RcStr::from))
+            .collect(),
+    ))
+}
+
