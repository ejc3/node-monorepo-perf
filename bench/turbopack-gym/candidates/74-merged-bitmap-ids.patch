+/// Distinct bitmaps, each stored once and named by an id: equal ids mean equal bitmaps.
+#[derive(Default)]
+struct BitmapInterner {
+    bitmaps: Vec<RoaringBitmapWrapper>,
+    ids: FxHashMap<RoaringBitmapWrapper, u32>,
+    unions: FxHashMap<(u32, u32), u32>,
+}
+
+impl BitmapInterner {
+    fn intern(&mut self, bitmap: RoaringBitmapWrapper) -> u32 {
+        if let Some(&id) = self.ids.get(&bitmap) {
+            return id;
+        }
+        let id = self.bitmaps.len() as u32;
+        self.bitmaps.push(bitmap.clone());
+        self.ids.insert(bitmap, id);
+        id
+    }
+
+    /// The id of `a`'s bitmap with `b`'s bits added.
+    fn union(&mut self, a: u32, b: u32) -> u32 {
+        if a == b {
+            return a;
+        }
+        if let Some(&id) = self.unions.get(&(a, b)) {
+            return id;
+        }
+        let (bitmap_a, bitmap_b) = (&self.bitmaps[a as usize], &self.bitmaps[b as usize]);
+        let id = if bitmap_b.is_subset(bitmap_a) {
+            a
+        } else {
+            let mut union = bitmap_a.clone();
+            *union |= &**bitmap_b;
+            self.intern(union)
+        };
+        self.unions.insert((a, b), id);
+        id
+    }
+
+    /// The id of `bitmap`'s bitmap (an empty one for `None`) with `bit` set.
+    fn with_bit(&mut self, bitmap: Option<u32>, bit: u32) -> u32 {
+        let mut with_bit = bitmap
+            .map(|id| self.bitmaps[id as usize].clone())
+            .unwrap_or_default();
+        with_bit.insert(bit);
+        self.intern(with_bit)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn bits(interner: &BitmapInterner, id: u32) -> Vec<u32> {
+        interner.bitmaps[id as usize].iter().collect()
+    }
+
+    /// Ids are equal exactly when the bitmaps are, however each bitmap was built.
+    #[test]
+    fn test_bitmap_interner_ids_match_contents() {
+        let mut interner = BitmapInterner::default();
+        let a = interner.with_bit(None, 1);
+        let b = interner.with_bit(None, 2);
+        assert_ne!(a, b);
+        assert_eq!(interner.with_bit(None, 1), a);
+
+        let ab = interner.union(a, b);
+        assert_eq!(bits(&interner, ab), vec![1, 2]);
+        assert_eq!(interner.union(b, a), ab);
+        assert_eq!(interner.with_bit(Some(a), 2), ab);
+        assert_eq!(interner.with_bit(Some(b), 1), ab);
+
+        // Adding bits that are already there keeps the id.
+        assert_eq!(interner.union(ab, a), ab);
+        assert_eq!(interner.union(ab, ab), ab);
+        assert_eq!(interner.with_bit(Some(ab), 1), ab);
+        // The operands are unchanged.
+        assert_eq!(bits(&interner, a), vec![1]);
+        assert_eq!(bits(&interner, b), vec![2]);
+    }
+}
