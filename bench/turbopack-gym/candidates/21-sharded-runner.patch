+
+/// The queue is split into at most this many shards, so that the set of non-empty shards fits
+/// into one [`AtomicU64`].
+const MAX_SHARDS: usize = 64;
+
+/// How many shards the queue is split into for a given number of workers.
+///
+/// A single queue behind a single lock is touched by every schedule, every claim and every time a
+/// worker picks up its next task. With dozens of workers that lock becomes the bottleneck:
+/// workers spend more time parked on it than executing tasks. Sharding the queue spreads those
+/// operations over independent locks. With few workers a single shard is contended little, and it
+/// keeps the priority order exact.
+fn shard_count(target_workers: usize) -> usize {
+    if target_workers < 8 {
+        1
+    } else {
+        (target_workers / 4).next_power_of_two().min(MAX_SHARDS)
+    }
+}
+
+thread_local! {
+    /// Per-thread rotating start index, so that threads popping from (or pushing unkeyed items
+    /// into) the sharded queue spread over the shards instead of all hitting the first one.
+    static SHARD_CURSOR: Cell<usize> = const { Cell::new(usize::MAX) };
+}
+
+fn next_shard_cursor() -> usize {
+    SHARD_CURSOR.with(|cursor| {
+        let mut value = cursor.get();
+        if value == usize::MAX {
+            // Seed each thread differently.
+            value = FxBuildHasher.hash_one(std::thread::current().id()) as usize >> 1;
+        }
+        cursor.set(value.wrapping_add(1));
+        value
+    })
+}
