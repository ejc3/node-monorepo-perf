+/// Reads `graph` for a traversal from `entry` alone. In a whole-app layer the result depends only
+/// on the subgraph reachable from `entry`, so this depends on that subgraph's hash (a keyed read)
+/// and reads the layer untracked: a change elsewhere in the app does not run the caller again.
+/// The hash is read first, so the layer read is at least as new as the layer it was computed
+/// from.
+async fn layer_for_entry(
+    graph: ResolvedVc<ModuleGraphLayer>,
+    entry: ResolvedVc<Box<dyn Module>>,
+) -> Result<ReadRef<ModuleGraphLayer>> {
+    let _ = graph.reachable_subgraph_hashes().get(&entry).await?;
+    Ok(graph.untracked().await?)
+}
