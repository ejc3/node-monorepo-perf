+#[turbo_tasks::value_impl]
+impl ModuleGraphLayer {
+    /// For every module of this layer, a hash of the subgraph reachable from it. See
+    /// [`ReachableSubgraphHashes`].
+    #[turbo_tasks::function]
+    pub async fn reachable_subgraph_hashes(self: Vc<Self>) -> Result<Vc<ReachableSubgraphHashes>> {
+        let layer = self.await?;
+        let span = tracing::info_span!("compute reachable subgraph hashes");
+        Ok(Vc::cell(
+            span.in_scope(|| layer.snapshot.reachable_subgraph_hashes())?,
+        ))
+    }
+}
+
+/// For every module of a [`ModuleGraphLayer`], a hash of what a traversal from it can see: the
+/// module, whether it is an entry, and everything reachable from it over any edge, each edge in
+/// order with its [`RefData`] and whether binding usage marks it unused. Two equal hashes mean a
+/// traversal from that module visits the same nodes over the same edges in the same order,
+/// whatever edges it filters out. A task whose result depends only on that can read its entry's
+/// hash (a keyed read, so other entries' changes do not invalidate it) and the layer untracked.
+#[turbo_tasks::value(transparent, cell = "keyed")]
+pub struct ReachableSubgraphHashes(FxHashMap<ResolvedVc<Box<dyn Module>>, u128>);
+
+/// Feeds [`Hash`] values to a 128-bit xxh3 hash. The `Hash` impls of [`ResolvedVc`], [`RefData`]
+/// and the integers do not depend on the process, so the hashes are the same in a later session
+/// for the same graph.
+struct Xxh3Hash128StdHasher(turbo_tasks_hash::Xxh3Hash128Hasher);
+
+impl std::hash::Hasher for Xxh3Hash128StdHasher {
+    fn finish(&self) -> u64 {
+        unreachable!("use finish128")
+    }
+
+    fn write(&mut self, bytes: &[u8]) {
+        turbo_tasks_hash::DeterministicHasher::write_bytes(&mut self.0, bytes);
+    }
+}
+
+impl Xxh3Hash128StdHasher {
+    fn new() -> Self {
+        Self(turbo_tasks_hash::Xxh3Hash128Hasher::new())
+    }
+
+    fn finish128(&self) -> u128 {
+        self.0.finish()
+    }
+}
