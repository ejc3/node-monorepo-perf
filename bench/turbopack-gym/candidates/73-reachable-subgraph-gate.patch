 impl ModuleGraphSnapshot {
+    /// See [`ReachableSubgraphHashes`]. Only for a layer: one graph whose visited-module nodes
+    /// are leaves.
+    fn reachable_subgraph_hashes(&self) -> Result<FxHashMap<ResolvedVc<Box<dyn Module>>, u128>> {
+        use std::hash::Hash;
+
+        let [graph] = &self.graphs[..] else {
+            bail!("reachable subgraph hashes need a single graph layer");
+        };
+        if !self.skip_visited_module_children {
+            bail!("reachable subgraph hashes need visited modules to be leaves");
+        }
+        let graph_idx = self.graph_idx_override.unwrap_or(0);
+        let g = &graph.graph.0;
+
+        // Each node's identity: its module, and whether the graph has it as a visited module.
+        let node_key = |node: NodeIndex| {
+            let mut h = Xxh3Hash128StdHasher::new();
+            match g.node_weight(node).unwrap() {
+                SingleModuleGraphNode::Module(module) => {
+                    0u8.hash(&mut h);
+                    module.hash(&mut h);
+                }
+                SingleModuleGraphNode::VisitedModule { module, .. } => {
+                    1u8.hash(&mut h);
+                    module.hash(&mut h);
+                }
+            }
+            h.finish128()
+        };
+
+        // Strongly connected components over every edge, in reverse topological order: each
+        // component comes after the components its edges lead to.
+        let sccs = petgraph::algo::kosaraju_scc(g);
+        let mut component = vec![usize::MAX; g.node_bound()];
+        for (i, scc) in sccs.iter().enumerate() {
+            for node in scc {
+                component[node.index()] = i;
+            }
+        }
+        let mut component_hash = vec![0u128; sccs.len()];
+        let mut node_hash = FxHashMap::with_capacity_and_hasher(g.node_count(), Default::default());
+        let entry_nodes = graph.entry_nodes();
+        for (i, scc) in sccs.iter().enumerate() {
+            // A component's members in an order that does not depend on node indices.
+            let mut members = scc.iter().map(|&n| (node_key(n), n)).collect::<Vec<_>>();
+            members.sort_unstable_by_key(|&(key, _)| key);
+            let position = members
+                .iter()
+                .enumerate()
+                .map(|(index, &(_, n))| (n, index))
+                .collect::<FxHashMap<_, _>>();
+
+            let mut h = Xxh3Hash128StdHasher::new();
+            members.len().hash(&mut h);
+            for &(key, node) in &members {
+                key.hash(&mut h);
+                // Edges in the order traversals visit them.
+                for edge in g.edges_directed(node, Direction::Outgoing) {
+                    edge.weight().hash(&mut h);
+                    self.unused_edges
+                        .as_ref()
+                        .is_some_and(|unused| {
+                            unused.contains(&GraphEdgeIndex::new(graph_idx, edge.id()))
+                        })
+                        .hash(&mut h);
+                    let target = edge.target();
+                    let target_component = component[target.index()];
+                    if target_component == i {
+                        0u8.hash(&mut h);
+                        position[&target].hash(&mut h);
+                    } else {
+                        if target_component > i {
+                            bail!("strongly connected components out of order");
+                        }
+                        1u8.hash(&mut h);
+                        component_hash[target_component].hash(&mut h);
+                    }
+                }
+            }
+            let hash = h.finish128();
+            component_hash[i] = hash;
+
+            for (index, &(_, node)) in members.iter().enumerate() {
+                let mut h = Xxh3Hash128StdHasher::new();
+                hash.hash(&mut h);
+                index.hash(&mut h);
+                entry_nodes.contains(&node).hash(&mut h);
+                node_hash.insert(g.node_weight(node).unwrap().module(), h.finish128());
+            }
+        }
+        Ok(node_hash)
+    }
