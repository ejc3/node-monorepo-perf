+type ClientReferenceManifests = Record<
+  string,
+  { entryJSFiles?: Record<string, string[]> }
+>
+
+function parseClientReferenceManifest(
+  source: string
+): ClientReferenceManifests | undefined {
+  const matches = [...source.matchAll(MANIFEST_ENTRY_LINE)]
+  if (matches.length !== 1) return undefined
+  try {
+    return { [JSON.parse(matches[0][1])]: JSON.parse(matches[0][2]) }
+  } catch {
+    return undefined
+  }
+}
+
+function requireClientReferenceManifest(
+  manifestFile: string
+): ClientReferenceManifests | undefined {
+  const g = global as Record<string, unknown>
+  const prev = g.__RSC_MANIFEST
+  g.__RSC_MANIFEST = undefined
+  try {
+    require(manifestFile)
+    return g.__RSC_MANIFEST as ClientReferenceManifests | undefined
+  } finally {
+    g.__RSC_MANIFEST = prev
+  }
+}
