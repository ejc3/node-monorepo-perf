                     let offset = meta.block_offsets_start(mmap.len());
                     let _ =
                         mmap.advise_range(memmap2::Advice::Sequential, offset, mmap.len() - offset);
+                    // An SST is opened on its first lookup. With `Random` advice every later
+                    // lookup faults its block in one page at a time, and lookups that depend
