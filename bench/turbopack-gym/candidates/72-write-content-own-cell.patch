+    static WRITE_FILES_RUNS: std::sync::atomic::AtomicUsize =
+        std::sync::atomic::AtomicUsize::new(0);
+
+    #[turbo_tasks::function(operation, root)]
+    async fn write_files_operation(root: RcStr, files: Vec<(RcStr, RcStr)>) -> anyhow::Result<()> {
+        WRITE_FILES_RUNS.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        let fs = DiskFileSystem::new(rcstr!("test"), Vc::cell(root));
+        let root_path = fs.root().await?;
+        for (name, contents) in files {
+            root_path
+                .join(&name)?
+                .write(FileContent::Content(File::from(contents)).cell())
+                .await?;
+        }
+        Ok(())
+    }
