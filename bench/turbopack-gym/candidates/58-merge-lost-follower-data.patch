+    /// Applies `updates` to `upper`, then sends what they changed there to `upper`'s uppers.
+    /// The changes all go to the same uppers, so they are merged into as few updates as
+    /// [`AggregatedDataUpdate::merge`] allows: the graph above `upper` is walked once for all of
+    /// them instead of once per update.
+    fn apply_and_push_to_uppers(
+        &mut self,
+        should_track_activeness: bool,
+        mut upper: TaskGuard<'_>,
+        updates: impl IntoIterator<Item = AggregatedDataUpdate>,
+    ) {
+        let mut merged: Option<AggregatedDataUpdate> = None;
+        let mut unmerged = Vec::new();
+        for data in updates {
+            let diff = data.apply(&mut upper, should_track_activeness, self);
+            if diff.is_empty() {
+                continue;
+            }
+            match &mut merged {
+                None => merged = Some(diff),
+                Some(merged) => {
+                    if let Some(diff) = merged.merge(diff) {
+                        unmerged.push(diff);
+                    }
+                }
+            }
+        }
+        let diffs: SmallVec<[AggregatedDataUpdate; 1]> = merged
+            .into_iter()
+            .chain(unmerged)
+            .filter(|diff| !diff.is_empty())
+            .collect();
+        if !diffs.is_empty() {
+            let upper_ids = get_uppers(&upper);
+            drop(upper);
+            for diff in diffs {
+                self.push(
+                    AggregatedDataUpdateJob {
+                        upper_ids: upper_ids.clone(),
+                        update: diff,
+                    }
+                    .into(),
+                );
+            }
+        }
+    }
