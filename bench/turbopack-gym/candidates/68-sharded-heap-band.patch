+/// One shard of the heap band.
+type HeapShard<P, K> = CachePadded<Mutex<BinaryHeap<HeapItem<P, K>>>>;
+
+/// The heap band is split into at most this many shards, so that the set of non-empty shards fits
+/// into one [`AtomicU64`].
+const MAX_HEAP_SHARDS: usize = 64;
+
+/// How many shards the heap band is split into for a given number of workers.
+///
+/// Every push and pop of an item above the lowest priority locks the heap. In a build that is
+/// recomputing after a change, most queued items are above the lowest priority, and with dozens of
+/// workers one heap lock becomes the point they wait on. Sharding spreads those operations over
+/// independent locks; with few workers a single heap is contended little and keeps the priority
+/// order exact.
+fn heap_shard_count(target_workers: usize) -> usize {
+    if target_workers < 8 {
+        1
+    } else {
+        (target_workers / 4)
+            .next_power_of_two()
+            .min(MAX_HEAP_SHARDS)
+    }
+}
