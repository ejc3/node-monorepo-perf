+/// The `n`-th set bit of `mask`, counting from bit `start` upwards and wrapping around. `mask`
+/// must not be zero.
+fn nth_set_bit_from(mask: u64, start: u32, n: u32) -> usize {
+    let rotated = mask.rotate_right(start % 64);
+    let mut rest = rotated;
+    for _ in 0..n % rotated.count_ones() {
+        rest &= rest - 1;
+    }
+    ((rest.trailing_zeros() + start) % 64) as usize
+}
