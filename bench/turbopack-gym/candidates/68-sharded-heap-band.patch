+thread_local! {
+    /// Per-thread rotating start, so that popping threads spread over the heap shards instead of
+    /// all looking at the first non-empty one.
+    static SHARD_CURSOR: Cell<u32> = const { Cell::new(u32::MAX) };
+}
+
+fn next_shard_cursor() -> u32 {
+    SHARD_CURSOR.with(|cursor| {
+        let mut value = cursor.get();
+        if value == u32::MAX {
+            // Seed each thread differently.
+            value = (FxBuildHasher.hash_one(std::thread::current().id()) >> 33) as u32;
+        }
+        cursor.set(value.wrapping_add(1));
+        value
+    })
+}
