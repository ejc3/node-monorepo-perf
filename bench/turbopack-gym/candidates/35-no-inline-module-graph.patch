diff --git a/turbopack/crates/turbo-tasks/src/manager.rs b/turbopack/crates/turbo-tasks/src/manager.rs
index 4e8053b4e8..51ef08b51b 100644
--- a/turbopack/crates/turbo-tasks/src/manager.rs
+++ b/turbopack/crates/turbo-tasks/src/manager.rs
@@ -615,9 +615,56 @@ thread_local! {
     static INLINE_EXECUTION_DEPTH: Cell<usize> = const { Cell::new(0) };
 }
 
-/// Whether the current thread may execute another task inline, see [`MAX_INLINE_EXECUTION_DEPTH`].
+thread_local! {
+    /// Set while a future that multiplexes many reads is polled, see
+    /// [`InlineExecutionSuppressed`].
+    static INLINE_EXECUTION_SUPPRESSED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Whether the current thread may execute another task inline, see [`MAX_INLINE_EXECUTION_DEPTH`]
+/// and [`InlineExecutionSuppressed`].
 fn inline_execution_allowed() -> bool {
-    INLINE_EXECUTION_DEPTH.get() < MAX_INLINE_EXECUTION_DEPTH
+    INLINE_EXECUTION_DEPTH.get() < MAX_INLINE_EXECUTION_DEPTH && !INLINE_EXECUTION_SUPPRESSED.get()
+}
+
+pin_project_lite::pin_project! {
+    /// Polls the inner future with read-triggered inline execution disabled on the polling
+    /// thread.
+    ///
+    /// A future that multiplexes many concurrent reads whose results produce more work (e.g. a
+    /// large graph traversal driving a `FuturesUnordered` of per-node futures) should not execute
+    /// the task one of those reads waits for inline: that would run the task serially inside the multiplexer's poll, so none of the
+    /// other reads would make progress, and no newly discovered work would be scheduled, until it
+    /// finishes. Instead the read waits for a worker, which leaves the multiplexer free to keep
+    /// scheduling work for all workers.
+    ///
+    /// Tasks that are executed inline by other reads are unaffected, since the suppression only
+    /// applies during this future's poll on this thread.
+    pub struct InlineExecutionSuppressed<F> {
+        #[pin]
+        future: F,
+    }
+}
+
+impl<F> InlineExecutionSuppressed<F> {
+    pub fn new(future: F) -> Self {
+        Self { future }
+    }
+}
+
+impl<F: Future> Future for InlineExecutionSuppressed<F> {
+    type Output = F::Output;
+
+    fn poll(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<F::Output> {
+        struct Restore(bool);
+        impl Drop for Restore {
+            fn drop(&mut self) {
+                INLINE_EXECUTION_SUPPRESSED.set(self.0);
+            }
+        }
+        let _restore = Restore(INLINE_EXECUTION_SUPPRESSED.replace(true));
+        self.project().future.poll(cx)
+    }
 }
 
 /// Counts one level of inline task execution on this thread, see [`MAX_INLINE_EXECUTION_DEPTH`].
