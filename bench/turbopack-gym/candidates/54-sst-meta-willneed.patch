+/// Starts reading a block's whole byte range into the page cache before its first access.
+///
+/// SST mappings carry `Random` advice, so without this every page of a block that is not
+/// cached faults in on its own, one read at a time, as the header read, CRC check and
+/// decompression walk it. Blocks average 16 KiB (keys) to 132 KiB (values), and a warm
+/// start's lookups depend on each other, so those reads queue one behind another.
+/// `WillNeed` submits the range as one read and does not wait for it; the first access then
+/// waits for that read only. Errors are ignored: this is only a hint.
+#[cfg(feature = "mmap")]
+fn prefetch_block(mmap: &Mmap, meta: &StaticSortedFileMetaData, block_index: u16) {
+    #[cfg(unix)]
+    {
+        let offset = meta.block_offsets_start(mmap.len()) + block_index as usize * 4;
+        let start = if block_index == 0 {
+            Some(0)
+        } else {
+            mmap.get(offset - 4..offset)
+                .map(|b| be::read_u32(b) as usize)
+        };
+        let end = mmap
+            .get(offset..offset + 4)
+            .map(|b| be::read_u32(b) as usize);
+        if let (Some(start), Some(end)) = (start, end)
+            && start < end
+            && end <= mmap.len()
+        {
+            let _ = mmap.advise_range(memmap2::Advice::WillNeed, start, end - start);
+        }
+    }
+    #[cfg(not(unix))]
+    let _ = (mmap, meta, block_index);
+}
