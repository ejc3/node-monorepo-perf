{
  "description": "Warm next build probes of where a warm start waits: the restored persistent cache read through mmap with MADV_RANDOM, against the page cache already holding it, TURBO_PERSISTENCE_MMAP=0 (pread), and candidates 53, 54 and 55. Single builds per case and rep, not paired A/Bs, except coldAB.",
  "method": {
    "app": "drift-monolith (the monolith app copied; the same tree the drift sweeps edit)",
    "builds": "one at a time on CPUs 0-23 of a dedicated 192-core box (no other gym work); TURBO_ENGINE_IGNORE_DIRTY=1",
    "seed": "the unchanged tree built cold with base (pageCache: base-fp) into .next-drift, then that directory reflink-copied as the snapshot",
    "warm": "the snapshot reflink-copied into .next-drift (new inodes: none of the cache in the page cache), trace files removed, then a build; N label edits applied first (drift.mjs editTargets/applyEdits), tree restored after",
    "modes": {
      "mmap": "default access mode (SST files mmapped)",
      "pread": "TURBO_PERSISTENCE_MMAP=0",
      "hot": "mmap, after every cache file was read once (cat), so the cache is in the page cache"
    },
    "check": "a no-edit warm build that emits a turbopack-module-graph span did not use the cache; such a run is refused (added after the version mismatch noted under invalid)",
    "disk": "btrfs raid0 over the instance's local NVMe drives",
    "bindings": "base and 53/54/55 as in bench/turbopack-gym/bindings.json; base-fp and 53-sst-block-willneed-fp are the same sources built with -Cforce-frame-pointers=yes for perf call graphs (not in bindings.json). Builds in pageCache, accessMode and the run55b hot rows come from the probe logs, which print no run ids; the other sets carry their run ids"
  },
