+    /// Adds `other` to this update, with the same effect on a task as applying this update and
+    /// then `other`: collectible changes are appended and dirty container counts of the same
+    /// container are summed. Returns `other` unchanged when both carry a dirty container update
+    /// for different containers, which one update cannot hold.
+    fn merge(&mut self, other: Self) -> Option<Self> {
+        let dirty_container_update =
+            match (self.dirty_container_update, other.dirty_container_update) {
+                (Some(a), Some(b)) if a.task_id != b.task_id => return Some(other),
+                (Some(a), Some(b)) => {
+                    let dirty_count = a.dirty_count + b.dirty_count;
+                    let current_session_clean_count =
+                        a.current_session_clean_count + b.current_session_clean_count;
+                    (dirty_count != 0 || current_session_clean_count != 0).then_some(
+                        DirtyContainerUpdate {
+                            task_id: a.task_id,
+                            dirty_count,
+                            current_session_clean_count,
+                        },
+                    )
+                }
+                (a, b) => a.or(b),
+            };
+        self.dirty_container_update = dirty_container_update;
+        self.collectibles_update.extend(other.collectibles_update);
+        None
+    }
